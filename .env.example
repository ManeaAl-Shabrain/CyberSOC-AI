CYBERSOC_MODE=local
CYBERSOC_AI_PROVIDER=mock
# Never commit Azure credentials or tokens.
# Optional local API settings. Load them explicitly in your shell.
# CYBERSOC_DB=./cybersoc.sqlite3
# CYBERSOC_API_TOKEN=
# Generate different local demo tokens. The approval API is disabled until both are set.
# CYBERSOC_ANALYST_TOKEN=
# CYBERSOC_REVIEWER_TOKEN=

# Optional Foundry replay. Use the versions printed by Foundry or the configure command.
# FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# FOUNDRY_TRIAGE_VERSION=
# FOUNDRY_INVESTIGATION_VERSION=
# FOUNDRY_DEPLOYMENT=gpt-4.1-mini
# Only needed for low quota. The verified 1,000 TPM demo used a 61-second pause.
# FOUNDRY_STAGE_DELAY_SECONDS=61
